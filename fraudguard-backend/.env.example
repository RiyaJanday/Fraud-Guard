# ============================================================================
# FraudGuard Backend — Environment Variable Template
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ============================================================================

ENVIRONMENT=development
# In production (Render), set this to ENVIRONMENT=production — it also
# disables the public /docs, /redoc, and /openapi.json endpoints (see
# app/main.py). DEBUG was removed: it was dead config that never gated
# anything (see backend README's production-readiness notes).

# --- Security / JWT ---------------------------------------------------
# Generate strong random values with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=changeme_generate_a_64_char_hex_secret
JWT_REFRESH_SECRET_KEY=changeme_generate_a_different_64_char_hex_secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Database (PostgreSQL) ----------------------------------------------
DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/fraudguard

# --- Redis ------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# --- CORS (comma-separated origins allowed to call this API) --------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Logging ------------------------------------------------------------
LOG_LEVEL=INFO
